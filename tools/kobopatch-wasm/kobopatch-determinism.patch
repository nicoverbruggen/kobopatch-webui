+func TestFindInstBLXOffset(t *testing.T) {
+	const tgt = uint32(0x1000)
+	buf := make([]byte, 64) // zeroed; AsmBLX never encodes to 0x0000, so no spurious matches
+	copy(buf[20:], AsmBLX(20, tgt))
+	p := NewPatcher(buf)
+
+	// exactly one match -> returns its position
+	pos, e := p.FindInstBLXOffset(0, 64, tgt)
+	nerr(t, e)
+	eq(t, pos, int32(20), "should locate the BLX at 20")
+
+	// window that does not reach the call -> zero matches is an error
+	_, e = p.FindInstBLXOffset(0, 10, tgt)
+	err(t, e)
+
+	// a second identical call in range -> ambiguous is an error (never silently picks one)
+	copy(buf[40:], AsmBLX(40, tgt))
+	_, e = NewPatcher(buf).FindInstBLXOffset(0, 64, tgt)
+	err(t, e)
+}
+
+func TestFindInstBWOffset(t *testing.T) {
+	const tgt = uint32(0x2000)
+	buf := make([]byte, 64)
+	copy(buf[12:], AsmBW(12, tgt))
+	p := NewPatcher(buf)
+
+	pos, e := p.FindInstBWOffset(0, 64, tgt)
+	nerr(t, e)
+	eq(t, pos, int32(12), "should locate the B.W at 12")
+
+	_, e = p.FindInstBWOffset(0, 8, tgt)
+	err(t, e)
+
+	copy(buf[30:], AsmBW(30, tgt))
+	_, e = NewPatcher(buf).FindInstBWOffset(0, 64, tgt)
+	err(t, e)
+}

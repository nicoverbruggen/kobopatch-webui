+// findInstUnique scans [base, base+window) in 2-byte (Thumb) steps for the single
+// position whose 4 bytes equal asm(pos), where asm encodes a PC-relative branch
+// (BLX/B.W) to a fixed target. Because the encoding is position-dependent, the
+// expected bytes are recomputed for every candidate position. It returns that
+// position, or an error if there are zero or more than one matches — so a patch
+// that searches for a call can never silently land on the wrong one.
+func (p *Patcher) findInstUnique(base, window int32, asm func(pos uint32) []byte) (int32, error) {
+	if window < 0 {
+		return 0, errors.New("window is less than 0")
+	}
+	if base < 0 || base >= int32(len(p.buf)) {
+		return 0, errors.New("base is out of range")
+	}
+	found := int32(-1)
+	count := 0
+	for off := int32(0); off < window; off += 2 {
+		pos := base + off
+		if int(pos)+4 > len(p.buf) {
+			break
+		}
+		want := asm(uint32(pos))
+		if p.buf[pos] == want[0] && p.buf[pos+1] == want[1] && p.buf[pos+2] == want[2] && p.buf[pos+3] == want[3] {
+			found = pos
+			count++
+		}
+	}
+	if count == 0 {
+		return 0, errors.New("no matching instruction found in window")
+	}
+	if count > 1 {
+		return 0, fmt.Errorf("found %d matching instructions in window (expected exactly 1)", count)
+	}
+	return found, nil
+}
+
+// FindInstBLXOffset returns the absolute position of the single BLX-to-tgt within
+// [base, base+window), or an error if there is not exactly one.
+func (p *Patcher) FindInstBLXOffset(base, window int32, tgt uint32) (int32, error) {
+	return p.findInstUnique(base, window, func(pos uint32) []byte { return AsmBLX(pos, tgt) })
+}
+
+// FindInstBWOffset returns the absolute position of the single B.W-to-tgt within
+// [base, base+window), or an error if there is not exactly one.
+func (p *Patcher) FindInstBWOffset(base, window int32, tgt uint32) (int32, error) {
+	return p.findInstUnique(base, window, func(pos uint32) []byte { return AsmBW(pos, tgt) })
+}
